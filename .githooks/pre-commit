#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

TODAY=$(date +%Y-%m-%d)
VERSION_FILE="$REPO_ROOT/version.py"
CHANGELOG="$REPO_ROOT/VERSION.md"

if ! [ -f "$VERSION_FILE" ] || ! [ -f "$CHANGELOG" ]; then
  exit 0
fi

if grep -qF "($TODAY)" "$CHANGELOG" 2>/dev/null; then
  exit 0
fi

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM -- '*.py' | grep -v '^version\.py$' || true)
if [ -z "$STAGED_PY" ]; then
  exit 0
fi

CURRENT_VERSION=$(sed -n 's/^__version__ = "\(.*\)"/\1/p' "$VERSION_FILE")
IFS='.' read -r MAJOR MINOR PATCH <<< "$CURRENT_VERSION"
NEW_VERSION="${MAJOR}.${MINOR}.$((PATCH + 1))"

sed -i "s/__version__ = .*/__version__ = \"${NEW_VERSION}\"/" "$VERSION_FILE"

TMP_CHANGELOG=$(mktemp)
echo "# 版本記錄" > "$TMP_CHANGELOG"
echo "" >> "$TMP_CHANGELOG"
echo "## v${NEW_VERSION} (${TODAY})" >> "$TMP_CHANGELOG"
echo "" >> "$TMP_CHANGELOG"
echo "- " >> "$TMP_CHANGELOG"
echo "" >> "$TMP_CHANGELOG"
tail -n +3 "$CHANGELOG" >> "$TMP_CHANGELOG"
mv "$TMP_CHANGELOG" "$CHANGELOG"

git add "$VERSION_FILE" "$CHANGELOG"

echo "  [auto-version] Bumped to v${NEW_VERSION}"
exit 0
